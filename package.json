{
  "name": "space-farmer",
  "version": "1.0.0",
  "description": "A cozy multiplayer space-farming game and deterministic reinforcement-learning environment.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/test.mjs",
    "dev": "node server.js",
    "test:offline": "node scripts/test.mjs --offline",
    "test:rl": "node rl/smoke.cjs 8",
    "test:python": "python3 -m unittest discover -s rl/python/tests -v",
    "benchmark": "python3 -m rl.python.benchmark",
    "train:ppo": "python3 -m rl.python.train_ppo",
    "check:public": "bash scripts/public_check.sh",
    "eval:local-model": "python3 -m rl.python.eval_local_model --resume",
    "compare:models": "python3 -m rl.python.compare_evals",
    "report:models": "python3 -m rl.python.render_eval_report",
    "rollout:tools": "python3 -m rl.python.rollout_tools",
    "transcript": "python3 -m rl.python.transcript",
    "eval:alignment": "python3 -m rl.python.eval_alignment"
  },
  "keywords": [
    "game",
    "reinforcement-learning",
    "gymnasium",
    "phaser",
    "colyseus"
  ],
  "license": "ISC",
  "dependencies": {
    "@colyseus/core": "^0.17.50",
    "@colyseus/schema": "^4.0.30",
    "@colyseus/sdk": "^0.17.43",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "private": false,
  "engines": {
    "node": ">=20"
  }
}
